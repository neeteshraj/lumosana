# Application Configuration
APP_NAME=transaction-debugger
APP_VERSION=1.0.0
ENVIRONMENT=development

# Server Configuration
HTTP_PORT=8080
GRPC_PORT=50051
HOST=0.0.0.0

# Logging Configuration
RUST_LOG=info

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=transaction-debugger
OTEL_SERVICE_VERSION=1.0.0
OTEL_RESOURCE_ATTRIBUTES=service.name=transaction-debugger,service.version=1.0.0,environment=development

# Jaeger Configuration
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
JAEGER_COLLECTOR_ENDPOINT=http://localhost:14268/api/traces
OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces

# OpenTelemetry Collector Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4317

# Prometheus Configuration
PROMETHEUS_ENDPOINT=localhost:9090
METRICS_PORT=9464

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# Performance Configuration
REQUEST_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=1000
WORKER_THREADS=4

# Database Configuration (if needed in future)
# DATABASE_URL=postgresql://localhost:5432/transaction_debugger
# DATABASE_MAX_CONNECTIONS=10
# DATABASE_MIN_CONNECTIONS=5

# External Services Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_TIMEOUT=30
SOLANA_WEBSOCKET_URL=wss://api.mainnet-beta.solana.com

# Security Configuration
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
# API_KEY_HEADER=X-API-Key

# Observability Configuration
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_LOGGING=true
TRACE_SAMPLING_RATE=1.0

# Development Configuration
DEBUG_MODE=false
HOT_RELOAD=false
PRETTY_LOGS=true

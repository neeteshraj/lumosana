# Docker Environment Configuration
APP_NAME=transaction-debugger
APP_VERSION=1.0.0
ENVIRONMENT=docker

# Server Configuration
HTTP_PORT=8080
GRPC_PORT=50051
HOST=0.0.0.0

# Logging Configuration (balanced for container environment)
RUST_LOG=info
RUST_BACKTRACE=1

# Performance Configuration
RUST_LOG_STYLE=never
CARGO_TERM_COLOR=never

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=transaction-debugger
OTEL_SERVICE_VERSION=1.0.0
OTEL_RESOURCE_ATTRIBUTES=service.name=transaction-debugger,service.version=1.0.0,environment=docker

# Jaeger Configuration (Docker compose setup)
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# OpenTelemetry Collector Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://34.87.159.61:4317
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://34.87.159.61:4317
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://34.87.159.61:4317

# Database Configuration (if needed)
DATABASE_URL=

# Security Configuration
ENABLE_CORS=true
CORS_ALLOWED_ORIGINS=*
MAX_REQUEST_SIZE=1048576

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_BURST_SIZE=100

# Timeout Configuration
REQUEST_TIMEOUT_SECONDS=30
SHUTDOWN_TIMEOUT_SECONDS=10

# Health Check Configuration
HEALTH_CHECK_INTERVAL_SECONDS=30
READINESS_CHECK_TIMEOUT_SECONDS=5

# Container Optimization
MALLOC_ARENA_MAX=2
MALLOC_MMAP_THRESHOLD=131072

# Debug Configuration (disabled for container)
DEBUG_MODE=false
PRETTY_LOGS=false
ENABLE_DEBUG_ENDPOINTS=false

# Solana RPC Configuration
DEFAULT_RPC_URL=https://api.mainnet-beta.solana.com
RPC_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# Feature Flags
ENABLE_TRACING=true
ENABLE_METRICS=true
ENABLE_PROFILING=false

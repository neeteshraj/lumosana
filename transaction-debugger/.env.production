# Production Environment Configuration
APP_NAME=transaction-debugger
APP_VERSION=1.0.0
ENVIRONMENT=production

# Server Configuration
HTTP_PORT=8080
GRPC_PORT=50051
HOST=0.0.0.0

# Logging Configuration (less verbose for production)
RUST_LOG=info

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=transaction-debugger
OTEL_SERVICE_VERSION=1.0.0
OTEL_RESOURCE_ATTRIBUTES=service.name=transaction-debugger,service.version=1.0.0,environment=production

# Jaeger Configuration (production setup - replace with actual values)
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
JAEGER_COLLECTOR_ENDPOINT=http://jaeger:14268/api/traces
OTEL_EXPORTER_JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# OpenTelemetry Collector Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4317

# Prometheus Configuration
PROMETHEUS_ENDPOINT=prometheus:9090
METRICS_PORT=9464

# Production Configuration
DEBUG_MODE=false
HOT_RELOAD=false
PRETTY_LOGS=false

# Performance Configuration (optimized for production)
REQUEST_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=1000
WORKER_THREADS=4

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# External Services Configuration (mainnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_TIMEOUT=30
SOLANA_WEBSOCKET_URL=wss://api.mainnet-beta.solana.com

# Security Configuration (restricted for production)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-API-Key

# Database Configuration (if needed)
# DATABASE_URL=postgresql://username:password@db-host:5432/transaction_debugger
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# Observability Configuration
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_LOGGING=true
TRACE_SAMPLING_RATE=0.1
